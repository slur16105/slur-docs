---
/**
 * FontCompare — Pretendard vs Noto Sans KR 가독성 비교 위젯.
 * SLUR 사이트가 Noto Sans KR로 폰트를 전환한 근거를 문서에서 직접 확인할 수 있게,
 * 두 폰트를 같은 텍스트·크기·행간 조건으로 나란히 렌더한다.
 * 테마·스무딩·크기 배율은 위젯 내부에서만 작동하며 사이트 테마를 건드리지 않는다.
 * 두 폰트 웹폰트 로드는 이 컴포넌트를 쓰는 페이지의 frontmatter `head`가 담당한다.
 *
 * NOTE: 샘플 텍스트를 set:html로 주입하므로 스타일은 반드시 is:global 이어야 한다.
 * (Astro의 scoped 스타일은 set:html로 들어온 요소에는 적용되지 않는다.)
 * 대신 모든 선택자를 `.fc` 하위로 한정해 전역 누수를 막는다.
 */
const sample = `
  <div class="fc_h1">SLUR UX/UI System<span class="fc_px" data-base="30">30px</span></div>
  <p class="fc_body">구조부터 사용자 경험까지, 한 번 구조화한 UI를 오래 유지하도록 설계하는 프론트엔드 UX/UI 시스템입니다. 클래스 이름만 봐도 <b>구조와 역할</b>이 읽히며, 특정 프레임워크에 종속되지 않습니다.<span class="fc_px" data-base="16">16px</span></p>
  <div class="fc_h2">다루는 범위<span class="fc_px" data-base="24">24px</span></div>
  <p class="fc_body">구조 설계에서 끝나지 않고, 상태·접근성·성능·경험까지 하나의 기준으로 이어집니다. 정상 상태만이 아니라 로딩·에러 상태, 접근성, 성능까지 처음부터 설계합니다.</p>
  <div class="fc_h3">핵심 원칙 — 역할 분리<span class="fc_px" data-base="18">18px</span></div>
  <p class="fc_body">구조는 HTML, 표현은 CSS, 동작은 JavaScript, 상태는 <code class="fc_code">data-state</code>가 담당합니다. 누가 작성해도 같은 구조로 읽히며, 일관성이 생산성을 만듭니다.</p>
  <p class="fc_small">접두사: layout_ · page_ · modal_ · i_ · m_ · mo_ · pc_ · 숫자 0123456789 · 1,234,567 · 2026-07-29 · v1.4.1<span class="fc_px" data-base="14">14px</span></p>
  <p class="fc_small">작은 글자 테스트 — 받침(밟·읊·긁·닭)이 뭉개지지 않는지, 획이 가늘게 번지지 않는지, 대비가 또렷한지 살펴보세요.</p>
  <p class="fc_c12">12px — 허용되는 최소 크기. 여기까지는 받침(밟·읊·긁)이 버팁니다.<span class="fc_px" data-base="12">12px</span></p>
  <p class="fc_c10">10px — SLUR에서 지양하는 크기. 획과 받침이 먼저 뭉개집니다.<span class="fc_px" data-base="10">10px</span></p>
`;
---

<div class="fc" data-theme="light" data-smoothing="on" style="--fc-scale:1;">
	<div class="fc_bar">
		<div class="fc_ctrl">
			<span class="fc_lbl">테마</span>
			<button type="button" class="fc_switch" role="switch" data-fc="theme" aria-checked="false" aria-label="테마 (라이트/다크)"><span class="fc_thumb"></span></button>
			<span class="fc_val" data-fc="themeval">라이트</span>
		</div>
		<div class="fc_ctrl">
			<span class="fc_lbl">스무딩(antialiased)</span>
			<button type="button" class="fc_switch" role="switch" data-fc="smoothing" aria-checked="true" aria-label="폰트 스무딩"><span class="fc_thumb"></span></button>
			<span class="fc_val" data-fc="smval">켜짐</span>
		</div>
		<div class="fc_ctrl fc_ctrl--grow">
			<span class="fc_lbl">크기 배율 <span data-fc="scaleval">1.00×</span></span>
			<input type="range" class="fc_range" data-fc="scale" min="0.85" max="1.4" step="0.05" value="1" aria-label="크기 배율">
		</div>
	</div>

	<div class="fc_grid">
		<div class="fc_col fc_pre">
			<span class="fc_tag">Pretendard</span>
			<Fragment set:html={sample} />
		</div>
		<div class="fc_col fc_noto">
			<span class="fc_tag">Noto Sans KR</span>
			<Fragment set:html={sample} />
		</div>
	</div>
</div>

<style is:global>
	.fc { --fc-bg:#ffffff; --fc-card:#ffffff; --fc-text:#363b41; --fc-heading:#14171a; --fc-muted:#6b737b; --fc-line:#e2e5e7; --fc-accent:#2f6bff; border: 1px solid var(--fc-line); border-radius: 12px; overflow: hidden; }
	.fc[data-theme="dark"] { --fc-bg:#14171a; --fc-card:#23272b; --fc-text:#cbcfd3; --fc-heading:#eef0f1; --fc-muted:#9aa1a8; --fc-line:#2b3036; --fc-accent:#5c8dff; }

	.fc .fc_bar { display: flex; flex-wrap: wrap; gap: 8px 20px; align-items: center; padding: 12px 16px; border-bottom: 1px solid var(--fc-line); background: var(--fc-bg); }
	.fc .fc_ctrl { display: flex; align-items: center; gap: 8px; margin-top: 0; }
	.fc .fc_ctrl--grow { flex: 1; min-width: 180px; }
	.fc .fc_lbl { font-size: 13px; color: var(--fc-muted); }
	.fc .fc_val { min-width: 2.4em; font-size: 13px; font-weight: 600; color: var(--fc-text); }
	.fc .fc_range { flex: 1; min-width: 120px; accent-color: var(--fc-accent); }

	.fc .fc_switch { flex: none; width: 40px; height: 22px; padding: 0; border: 0; border-radius: 999px; background: var(--fc-line); cursor: pointer; transition: background .15s ease; }
	.fc .fc_switch[aria-checked="true"] { background: var(--fc-accent); }
	.fc .fc_thumb { display: block; width: 18px; height: 18px; margin: 2px; border-radius: 50%; background: #fff; box-shadow: 0 1px 2px rgba(0,0,0,.25); transition: transform .15s ease; }
	.fc .fc_switch[aria-checked="true"] .fc_thumb { transform: translateX(18px); }

	/* margin-top:0 — Starlight의 `.sl-markdown-content :not(…)+:not(…)` 인접 규칙이
	   이 그리드에 얹는 상단 마진을 상쇄. `.fc .fc_grid`(0,2,0)가 그 규칙(0,1,2)을 이겨 !important 불필요. */
	.fc .fc_grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; margin: 0; background: var(--fc-line); }
	@media (max-width: 640px) { .fc .fc_grid { grid-template-columns: 1fr; } }

	.fc .fc_col { padding: 24px; background: var(--fc-bg); }
	.fc .fc_col > :first-child { margin-top: 0; }
	.fc .fc_col > :last-child { margin-bottom: 0; }
	.fc[data-smoothing="on"] .fc_col { -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; }
	.fc[data-smoothing="off"] .fc_col { -webkit-font-smoothing: auto; -moz-osx-font-smoothing: auto; }
	.fc .fc_pre { font-family: "Pretendard Variable", "Pretendard", sans-serif; }
	.fc .fc_noto { font-family: "Noto Sans KR", sans-serif; margin-top: 0; }

	.fc .fc_tag { display: inline-block; margin-bottom: 16px; font-size: 12px; font-weight: 600; letter-spacing: .03em; text-transform: uppercase; color: var(--fc-muted); }
	.fc .fc_h1 { font-size: calc(30px * var(--fc-scale)); font-weight: 600; line-height: 1.25; letter-spacing: -.02em; color: var(--fc-heading); margin: 0 0 8px; }
	.fc .fc_h2 { font-size: calc(24px * var(--fc-scale)); font-weight: 600; line-height: 1.3; letter-spacing: -.02em; color: var(--fc-heading); margin: 20px 0 6px; }
	.fc .fc_h3 { font-size: calc(18px * var(--fc-scale)); font-weight: 600; line-height: 1.4; color: var(--fc-heading); margin: 16px 0 6px; }
	.fc .fc_body { font-size: calc(16px * var(--fc-scale)); font-weight: 400; line-height: 1.7; color: var(--fc-text); margin: 0 0 12px; }
	.fc .fc_small { font-size: calc(14px * var(--fc-scale)); font-weight: 400; line-height: 1.6; color: var(--fc-muted); margin: 0 0 8px; }
	.fc .fc_c12 { font-size: calc(12px * var(--fc-scale)); font-weight: 400; line-height: 1.6; color: var(--fc-text); margin: 12px 0 0; }
	.fc .fc_c10 { font-size: calc(10px * var(--fc-scale)); font-weight: 400; line-height: 1.6; color: var(--fc-muted); margin: 4px 0 0; }
	.fc .fc_body b { font-weight: 700; color: var(--fc-heading); }
	.fc .fc_px { display: inline-block; margin-left: .5em; padding: 1px 6px; border-radius: 999px; background: color-mix(in srgb, var(--fc-muted) 16%, transparent); font-family: ui-monospace, monospace; font-size: 11px; font-weight: 500; line-height: 1.6; letter-spacing: 0; color: var(--fc-muted); vertical-align: middle; white-space: nowrap; }
	.fc .fc_code { font-family: ui-monospace, monospace; font-size: .85em; padding: 1px 5px; border-radius: 4px; background: color-mix(in srgb, var(--fc-muted) 22%, transparent); }
</style>

<script>
	document.querySelectorAll<HTMLElement>(".fc").forEach((fc) => {
		const q = (sel: string) => fc.querySelector(sel) as HTMLElement | null;
		const themeBtn = q('[data-fc="theme"]');
		const themeVal = q('[data-fc="themeval"]');
		const smBtn = q('[data-fc="smoothing"]');
		const smVal = q('[data-fc="smval"]');
		const scale = q('[data-fc="scale"]') as HTMLInputElement | null;
		const scaleVal = q('[data-fc="scaleval"]');

		themeBtn?.addEventListener("click", () => {
			const dark = themeBtn.getAttribute("aria-checked") === "true";
			themeBtn.setAttribute("aria-checked", String(!dark));
			fc.setAttribute("data-theme", dark ? "light" : "dark");
			if (themeVal) themeVal.textContent = dark ? "라이트" : "다크";
		});

		smBtn?.addEventListener("click", () => {
			const on = smBtn.getAttribute("aria-checked") === "true";
			smBtn.setAttribute("aria-checked", String(!on));
			fc.setAttribute("data-smoothing", on ? "off" : "on");
			if (smVal) smVal.textContent = on ? "꺼짐" : "켜짐";
		});

		const pxEls = fc.querySelectorAll<HTMLElement>(".fc_px");
		const syncPx = (s: number) => {
			pxEls.forEach((el) => {
				const base = parseFloat(el.getAttribute("data-base") || "0");
				el.textContent = Math.round(base * s) + "px";
			});
		};

		scale?.addEventListener("input", () => {
			const s = parseFloat(scale.value);
			fc.style.setProperty("--fc-scale", scale.value);
			if (scaleVal) scaleVal.textContent = s.toFixed(2) + "×";
			syncPx(s);
		});

		syncPx(scale ? parseFloat(scale.value) : 1);
	});
</script>
